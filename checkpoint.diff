+      },
+      variants: {
+        where: { isActive: true },
+        include: { inventory: true },
+        orderBy: { createdAt: "asc" },
+      },
+    },
+    orderBy: { createdAt: "asc" },
+  });
+
+  return products.map(mapProductToStorefrontDto);
+}
