generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  RESTOCK
  RESERVATION
  RELEASE
}

enum RewardStatus {
  PENDING
  AVAILABLE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model User {
  id              String                   @id @default(cuid())
  clerkId         String?                  @unique
  email           String                   @unique
  firstName       String?
  lastName        String?
  isAdmin         Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  addresses       Address[]
  carts           Cart[]
  orders          Order[]
  rewards         Reward[]
  puzzleProgress  CustomerPuzzleProgress[]
  redeemedQRCodes QRCode[]                 @relation("RedeemedBy")
}

model Brand {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  imageUrl    String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    Product[]
  collections Collection[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Collection {
  id          String             @id @default(cuid())
  brandId     String
  brand       Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  imageUrl    String?
  isActive    Boolean            @default(true)
  products    Product[]
  puzzles     PuzzleCollection[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([brandId, slug])
  @@index([brandId, isActive])
}

model Product {
  id             String                 @id @default(cuid())
  brandId        String
  brand          Brand                  @relation(fields: [brandId], references: [id])
  categoryId     String
  category       Category               @relation(fields: [categoryId], references: [id])
  name           String
  slug           String                 @unique
  description    String
  price          Decimal                @db.Decimal(12, 2)
  compareAtPrice Decimal?               @db.Decimal(12, 2)
  baseSku        String                 @unique
  gender         Gender                 @default(UNISEX)
  material       String?
  fit            String?
  isActive       Boolean                @default(false)
  isFeatured     Boolean                @default(false)
  isNewArrival   Boolean                @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  collections    Collection[]
  variants       ProductVariant[]
  images         ProductImage[]
  puzzleMappings ProductPuzzleMapping[]
  qrCodes        QRCode[]

  @@index([brandId, isActive])
  @@index([categoryId, isActive])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String      @unique
  size       String
  color      String
  price      Decimal?    @db.Decimal(12, 2)
  isActive   Boolean     @default(true)
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([productId, size, color])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?
  altText   String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model Inventory {
  id           String                 @id @default(cuid())
  variantId    String                 @unique
  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity     Int                    @default(0)
  reserved     Int                    @default(0)
  reorderAt    Int                    @default(0)
  version      Int                    @default(0)
  updatedAt    DateTime               @updatedAt
  transactions InventoryTransaction[]
}

model InventoryTransaction {
  id          String                   @id @default(cuid())
  inventoryId String
  inventory   Inventory                @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        InventoryTransactionType
  quantity    Int
  reason      String?
  orderId     String?
  createdAt   DateTime                 @default(now())

  @@index([inventoryId, createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?    @unique
  status    CartStatus @default(ACTIVE)
  couponId  String?
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  items     CartItem[]
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, status])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model Address {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AddressType
  firstName  String
  lastName   String
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          OrderStatus @default(PENDING)
  email           String
  currency        String      @default("usd")
  subtotal        Decimal     @db.Decimal(12, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(12, 2)
  shippingTotal   Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  shippingAddress Json
  billingAddress  Json
  couponCode      String?
  items           OrderItem[]
  payments        Payment[]
  qrCodes         QRCode[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id            String                   @id @default(cuid())
  orderId       String
  order         Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant?          @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName   String
  variantName   String
  sku           String
  unitPrice     Decimal                  @db.Decimal(12, 2)
  quantity      Int
  total         Decimal                  @db.Decimal(12, 2)
  puzzleUnlocks CustomerPuzzleProgress[]

  @@index([orderId])
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider           String        @default("stripe")
  providerPaymentId  String?       @unique
  providerCheckoutId String?       @unique
  status             PaymentStatus @default(PENDING)
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @default("usd")
  failureReason      String?
  refundedAmount     Decimal       @default(0) @db.Decimal(12, 2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([orderId, status])
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Decimal    @db.Decimal(12, 2)
  minimumSpend    Decimal?   @db.Decimal(12, 2)
  maximumDiscount Decimal?   @db.Decimal(12, 2)
  usageLimit      Int?
  usageCount      Int        @default(0)
  startsAt        DateTime?
  expiresAt       DateTime?
  isActive        Boolean    @default(true)
  carts           Cart[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Reward {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      RewardStatus @default(PENDING)
  points      Int          @default(0)
  code        String?      @unique
  availableAt DateTime?
  redeemedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, status])
}

model PuzzleCollection {
  id              String                   @id @default(cuid())
  collectionId    String
  collection      Collection               @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name            String
  slug            String                   @unique
  description     String?
  finalArtworkUrl String
  rewardName      String?
  isActive        Boolean                  @default(false)
  pieces          PuzzlePiece[]
  progress        CustomerPuzzleProgress[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
}

model PuzzlePiece {
  id        String                   @id @default(cuid())
  puzzleId  String
  puzzle    PuzzleCollection         @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  name      String
  imageUrl  String
  position  Int
  mappings  ProductPuzzleMapping[]
  progress  CustomerPuzzleProgress[]
  qrCodes   QRCode[]
  createdAt DateTime                 @default(now())

  @@unique([puzzleId, position])
}

model ProductPuzzleMapping {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  pieceId   String
  piece     PuzzlePiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([productId, pieceId])
  @@index([pieceId])
}

model CustomerPuzzleProgress {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleId    String
  puzzle      PuzzleCollection @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  pieceId     String
  piece       PuzzlePiece      @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id])
  unlockedAt  DateTime         @default(now())

  @@unique([userId, pieceId])
  @@index([userId, puzzleId])
}

model QRCode {
  id           String       @id @default(cuid())
  tokenHash    String       @unique
  productId    String?
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  pieceId      String?
  piece        PuzzlePiece? @relation(fields: [pieceId], references: [id], onDelete: SetNull)
  orderId      String?
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  isActive     Boolean      @default(true)
  redeemedAt   DateTime?
  redeemedById String?
  redeemedBy   User?        @relation("RedeemedBy", fields: [redeemedById], references: [id], onDelete: SetNull)
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())

  @@index([productId])
  @@index([redeemedById])
}
